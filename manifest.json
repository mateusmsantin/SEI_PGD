{
  "manifest_version": 3,
  "name": "SEI → Cobalto",
  "version": "1.0.0",
  "description": "Registra os processos e despachos trabalhados no SEI e lança as atividades no Cobalto (plano de trabalho).",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://sei.ufpel.edu.br/*",
    "https://cobalto.ufpel.edu.br/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SEI → Cobalto" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://sei.ufpel.edu.br/*"],
      "js": ["common.js", "sei-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cobalto.ufpel.edu.br/*"],
      "js": ["common.js", "cobalto-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cobalto.ufpel.edu.br/*"],
      "js": ["cobalto-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
